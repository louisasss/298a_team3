{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis Input",
  "type": "object",
  "properties": {
    "canary_pod_hash": {
        "type": "string", 
        "minLength": 1, 
        "description": "pod-template-hash for the canary ReplicaSet"
    },
    "stable_pod_hash": {
        "type": "string",
        "minLength": 1,
        "description": "pod-template-hash for the stable ReplicaSet"
    },
    "rollout_name": {
        "type": "string",
        "minLength": 1,
        "description": "which Rollout the tools should look up"
    },
    "namespace": {
        "type": "string",
        "minLength": 1,
        "description": "which Kubernetes namespace"
    }
  },
  "required": ["canary_pod_hash", "stable_pod_hash", "rollout_name", "namespace"],
  "additionalProperties": false
}